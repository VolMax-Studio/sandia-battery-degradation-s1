# Data Handling Invariant (B-6 Prevention)
# Raw telemetry datasets and binary time-series must never be committed to git.
# Public repository distributes data_manifest.json, checksums, and reproducible scripts only.

data/
raw/
downloads/
cache/

# Binary & tabular raw files
*.parquet
*.feather
*.h5
*.h5py
*.mat
*.pkl

# Ignore all CSVs except pinned L0 metadata, reference artifacts, and result tables
*.csv
!evidence/l0/source_pages/batteryarchive_metadata.csv
!artifacts/*.csv
!runs/*/*.csv

# Raw telemetry downloads in runs
runs/*/raw_data/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/

# Private custody stays outside the public repository
*.eml
**/host_response/
**/batteryarchive_host_shares/
**/execution/authorization.json
**/execution_custody/operator_authorization.json
**/ORIGINAL_GO_*
**/*CLOSURE*PRIVATE*.zip
**/*SUPPLEMENT_PRIVATE*.zip
